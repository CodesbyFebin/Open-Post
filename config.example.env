# Server Configuration
PORT=3000
NODE_ENV=production
DRY_RUN=false

# Autopilot AI Engine (Choose: heuristic, openai, anthropic, or ollama)
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434

# Channel Credentials (Optional: can also be configured via UI)
# Twitter / X API v2
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn UGC API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Reddit API
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=

# Bluesky
BLUESKY_IDENTIFIER=
BLUESKY_PASSWORD=

# Generic Outbound Webhook (n8n, Make, Zapier)
WEBHOOK_URL=
WEBHOOK_SECRET=
