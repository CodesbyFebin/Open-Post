{
  "name": "open-post",
  "version": "1.1.0",
  "description": "Free, self-hosted social media scheduler and AI autopilot. One Node process, SQLite, no Redis or Temporal. Publishes to X, LinkedIn, Reddit, Bluesky and webhooks.",
  "main": "server.js",
  "bin": { "open-post": "cli.js" },
  "type": "commonjs",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tick": "node cli.js tick",
    "test": "node --test test/*.test.js",
    "lint": "eslint ."
  },
  "keywords": ["social-media", "scheduler", "social-media-scheduler", "autopilot", "postiz-alternative", "buffer-alternative", "self-hosted", "sqlite", "twitter", "x-api", "linkedin", "reddit", "bluesky", "atproto", "ollama", "openai", "ai-agent", "open-source"],
  "author": "CodesbyFebin and Open Post contributors",
  "license": "MIT",
  "homepage": "https://codesbyfebin.github.io/Open-Post/",
  "repository": { "type": "git", "url": "git+https://github.com/CodesbyFebin/Open-Post.git" },
  "bugs": { "url": "https://github.com/CodesbyFebin/Open-Post/issues" },
  "dependencies": { "express": "^4.21.2" },
  "optionalDependencies": { "better-sqlite3": "^11.7.0" },
  "devDependencies": { "@eslint/js": "^10.0.1", "eslint": "^10.13.0", "globals": "^17.13.0" }
}
