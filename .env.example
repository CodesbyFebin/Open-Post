# ---------------------------------------------------------------
# Open Post configuration. Copy to .env and fill in what you need.
# Secrets live ONLY here (or in your process manager) — never in the DB.
# ---------------------------------------------------------------

# Server
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# auto | sqlite | json
STORE_DRIVER=auto
# Cadence slots use the server's local time. Set TZ to your zone, e.g. Asia/Kolkata
TZ=UTC
# Protect the API and dashboard with a bearer token (recommended on public hosts)
API_TOKEN=
# Allow a separate front-end origin (optional)
CORS_ORIGIN=

# Sandbox: true = every channel is routed to the sandbox driver; nothing is sent
SANDBOX_MODE=false

# Scheduler
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_DISABLED=false
MAX_PUBLISH_ATTEMPTS=3

# AI provider: heuristic | openai | anthropic | gemini | ollama
AI_PROVIDER=heuristic
AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- X (Twitter) API v2 — OAuth 1.0a user context (recommended) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# ...or an OAuth 2.0 user-context token with tweet.write scope
X_OAUTH2_USER_TOKEN=

# --- LinkedIn UGC API (w_member_social / w_organization_social) ---
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:XXXX or urn:li:organization:XXXX
LINKEDIN_AUTHOR_URN=

# --- Reddit (script app) — either a token, or client credentials + password grant ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=open-post/1.1 (by u/your_username)

# --- Bluesky (use an App Password, not your main password) ---
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# --- Outbound webhook (n8n, Make, Zapier, your own service) ---
WEBHOOK_URL=
# If set, requests carry X-Open-Post-Signature: sha256=<hmac of body>
WEBHOOK_SECRET=

# Multiple accounts: create a channel with envPrefix X_BRAND2 and set X_BRAND2_API_KEY etc.
